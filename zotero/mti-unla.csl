<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="id-ID">
  <info>
    <title>Magister Teknik Informatika Universitas Langlangbuana (nama-tahun)</title>
    <title-short>MTI UnLa</title-short>
    <id>http://www.zotero.org/styles/mti-unla</id>
    <link href="http://www.zotero.org/styles/mti-unla" rel="self"/>
    <author>
      <name>Program Studi Magister Teknik Informatika UnLa</name>
    </author>
    <category citation-format="author-date"/>
    <category field="engineering"/>
    <summary>Gaya sitasi nama-tahun sesuai Bab VI dan Lampiran Q Pedoman Penulisan Tesis MTI UnLa Edisi Revisi 2026: (Kramer dkk., 2005); Cotton, F. A. (1998): Judul, Jurnal, 54, 38–43.</summary>
    <updated>2026-11-23T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="id">
    <terms>
      <term name="and">dan</term>
      <term name="et-al">dkk.</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>ed.</multiple>
      </term>
      <term name="in">dalam</term>
      <term name="accessed">Diakses</term>
      <term name="page" form="short">
        <single>hal.</single>
        <multiple>hal.</multiple>
      </term>
      <term name="no date" form="short">t.t.</term>
      <term name="edition">edisi</term>
    </terms>
    <date form="text">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </locale>
  <macro name="author-bib">
    <names variable="author">
      <name and="text" delimiter-precedes-last="contextual" initialize-with=". " name-as-sort-order="all" sort-separator=", " delimiter=", "/>
      <label form="short" prefix=" (" suffix=")" text-case="capitalize-first"/>
      <substitute>
        <names variable="editor"/>
        <names variable="director"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-cite">
    <names variable="author">
      <name form="short" and="text" delimiter=", " et-al-min="3" et-al-use-first="1" delimiter-precedes-et-al="never"/>
      <substitute>
        <names variable="editor"/>
        <names variable="director"/>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor-in">
    <names variable="editor">
      <name and="text" delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all" sort-separator=", " delimiter=", "/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <macro name="date-bib">
    <choose>
      <if type="article-newspaper broadcast" match="any">
        <date variable="issued" form="text" prefix="(" suffix=")"/>
      </if>
      <else>
        <group prefix="(" suffix=")">
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="year-suffix"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="year-cite">
    <choose>
      <if variable="issued">
        <group>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="year-suffix"/>
        </group>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix=". https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <group delimiter=". " prefix=", ">
          <text variable="URL"/>
          <group delimiter=" ">
            <text term="accessed"/>
            <date variable="accessed" form="text"/>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="body">
    <choose>
      <if type="article-journal article-magazine" match="any">
        <group delimiter=", ">
          <text variable="title"/>
          <text variable="container-title" font-style="italic"/>
          <text variable="volume" font-weight="bold"/>
          <choose>
            <if variable="page">
              <text variable="page"/>
            </if>
            <else>
              <text variable="number"/>
            </else>
          </choose>
        </group>
      </if>
      <else-if type="article-newspaper">
        <group delimiter=", ">
          <text variable="title"/>
          <text variable="container-title" font-style="italic"/>
          <group delimiter=" ">
            <label variable="page" form="short"/>
            <text variable="page"/>
          </group>
        </group>
      </else-if>
      <else-if type="book report" match="any">
        <group delimiter=", ">
          <text variable="title" font-style="italic"/>
          <group delimiter=" ">
            <text variable="genre"/>
            <text variable="number"/>
          </group>
          <group delimiter=" ">
            <text term="edition"/>
            <number variable="edition" form="ordinal"/>
          </group>
          <text macro="publisher"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="chapter">
        <group delimiter=", ">
          <group delimiter=" ">
            <group delimiter=", ">
              <text variable="title"/>
              <text variable="page"/>
            </group>
            <text term="in"/>
            <text macro="editor-in"/>
          </group>
          <text variable="container-title" font-style="italic"/>
          <text macro="publisher"/>
        </group>
      </else-if>
      <else-if type="paper-conference">
        <group delimiter=", ">
          <text variable="title"/>
          <text variable="container-title" font-style="italic"/>
          <text variable="event-place"/>
          <text macro="editor-in"/>
          <text variable="publisher"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=", ">
          <text variable="title" font-style="italic"/>
          <text variable="genre"/>
          <text variable="publisher"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="motion_picture broadcast software" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="title"/>
            <text variable="version" prefix="(" suffix=")"/>
            <text variable="genre" prefix="[" suffix="]"/>
          </group>
          <text macro="publisher"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="title"/>
            <text variable="genre" prefix="[" suffix="]"/>
          </group>
          <text variable="container-title" font-style="italic"/>
          <text macro="publisher"/>
          <text variable="page"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year" after-collapse-delimiter="; " givenname-disambiguation-rule="primary-name">
    <sort>
      <key macro="author-cite"/>
      <key macro="year-cite"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=": ">
        <group delimiter=", ">
          <text macro="author-cite"/>
          <text macro="year-cite"/>
        </group>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author-bib"/>
      <key variable="issued"/>
    </sort>
    <layout suffix=".">
      <group delimiter=": ">
        <group delimiter=" ">
          <text macro="author-bib"/>
          <text macro="date-bib"/>
        </group>
        <group>
          <text macro="body"/>
          <text macro="access"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
